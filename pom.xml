<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.commonpay</groupId>
    <artifactId>common-pay</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>可嵌入交易内核 + 可插拔支付</description>

    <modules>
        <module>pay-api</module>
        <module>pay-channel-mock</module>
        <module>pay-channel-wechat</module>
        <module>pay-channel-alipay</module>
        <module>trade-core</module>
        <module>common-pay-spring-boot-starter</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.commonpay</groupId>
                <artifactId>pay-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commonpay</groupId>
                <artifactId>pay-channel-mock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commonpay</groupId>
                <artifactId>pay-channel-wechat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commonpay</groupId>
                <artifactId>pay-channel-alipay</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commonpay</groupId>
                <artifactId>trade-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commonpay</groupId>
                <artifactId>common-pay-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        声明 @ConfigurationProperties 的模块（starter / pay-channel-alipay / pay-channel-wechat）
        靠它生成 META-INF/spring-configuration-metadata.json，
        业务方在 application.yml 写 common-pay.* 时 IDE 才有补全与说明。
        必须 optional：编译期工具，不能传递给业务方。
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
